# GSPlatform environment variables (example only — never commit real values)

# --- Web (Vite) ---
# VITE_ variables are only exposed to the browser; never put secrets here.
# Default (absolute) points the browser straight at the API. If you also set
# GS_API_PROXY_TARGET to run against an isolated DB, set this to `/api/v1`
# instead — otherwise the page and the e2e `request` fixture talk to two
# DIFFERENT databases (the page bypasses the vite proxy), which looks like a
# product bug but is not one.
VITE_API_BASE_URL=http://localhost:8001
VITE_XR_PERFORMANCE_DIAGNOSTICS=false

# --- Viewer ---
VITE_VIEWER_PORT=5174

# --- API ---
GS_API_HOST=0.0.0.0
GS_API_PORT=8001
GS_API_ENV=development
# GS_DATABASE_URL=postgresql+psycopg://gsplatform:CHANGE_ME@localhost:5432/gsplatform
# GS_REDIS_URL=redis://localhost:6379/0
# GS_SECRET_KEY=CHANGE_ME

# --- Workers (Celery) ---
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
GS_CONVERT_GPU=cpu
GS_CONVERT_TIMEOUT_S=14400
GS_TASK_TIME_LIMIT_S=18000
GS_TASK_SOFT_TIME_LIMIT_S=17400
# Omitted upload/reconstruction visibility; explicit client visibility always wins.
GS_DEFAULT_UPLOAD_VISIBILITY=PRIVATE
