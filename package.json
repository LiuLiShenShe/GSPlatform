{
  "name": "gsplatform",
  "version": "0.0.0",
  "private": true,
  "description": "GSPlatform - 3D Gaussian Splatting scene platform monorepo",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @gsplatform/web dev",
    "dev": "pnpm run dev:web",
    "lint:web": "pnpm --filter @gsplatform/web lint",
    "lint": "pnpm run lint:web",
    "typecheck:web": "pnpm --filter @gsplatform/web typecheck",
    "typecheck": "pnpm run typecheck:web",
    "test:web": "pnpm --filter @gsplatform/web test",
    "test": "pnpm run test:web",
    "build:web": "pnpm --filter @gsplatform/web build",
    "build": "pnpm run build:web",
    "api:check": "cd apps/api && .venv/bin/python -m ruff check . && .venv/bin/python -m mypy app && .venv/bin/python -m pytest -q",
    "api:dev": "cd apps/api && .venv/bin/python -m uvicorn app.main:app --reload --host 0.0.0.0 --port ${GS_API_PORT:-8001}",
    "legacy:viewer:dev": "pnpm --filter @gsplatform/viewer dev",
    "legacy:viewer:build": "pnpm --filter @gsplatform/viewer build",
    "legacy:viewer:typecheck": "pnpm --filter @gsplatform/viewer typecheck",
    "legacy:viewer:lint": "pnpm --filter @gsplatform/viewer lint"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
