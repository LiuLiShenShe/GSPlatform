# GSPlatform production environment variables — EXAMPLE ONLY.
#
# Copy to /etc/gsplatform/env (outside the repo), chown to the runtime user,
# chmod 600, and fill in REAL values. NEVER commit real secrets.
#
# File layout expected by deploy/systemd/*.service:
#   /etc/gsplatform/env  (loaded via EnvironmentFile=)
#
# Required secret values to set before first deploy:
#   GS_SECRET_KEY, GS_DATABASE_URL, GS_REDIS_URL, GS_SESSION_SECURE_COOKIE,
#   GS_CORS_ORIGINS, AI_* (optional), GS_API_HOST/GS_API_PORT.

# --- API / FastAPI -----------------------------------------------------------
# In production the API binds localhost only; Nginx is the public gateway.
GS_ENV=production
GS_API_HOST=127.0.0.1
GS_API_PORT=8001

# Application identity guard: production must NEVER enable dev identity bypass.
GS_DEV_IDENTITY_ENABLED=false

# --- Postgres / Redis (Phase 05/06) ------------------------------------------
# Fill with the real private-interface URL.  App role must be least-privilege;
# the role is granted only to the `gsplatform` database (see BACKUP_RESTORE_RUNBOOK).
GS_DATABASE_URL=postgresql+psycopg2://gsplatform:CHANGE_ME@127.0.0.1:5432/gsplatform

GS_REDIS_URL=redis://127.0.0.1:6379/0
GS_CELERY_BROKER_URL=redis://127.0.0.1:6379/0
GS_CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# --- Sessions / CSRF (Phase 08) ---
# Must be true on HTTPS so the session cookie is only sent over TLS.
GS_SESSION_SECURE_COOKIE=true
GS_SESSION_SAME_SITE=lax
GS_SECRET_KEY=CHANGE_ME_48+_random_bytes

# Rate limits (Phase 08)
GS_RATE_LIMIT_LOGIN_PER_MINUTE=5
GS_RATE_LIMIT_REGISTER_PER_HOUR=10
GS_RATE_LIMIT_SHARE_PER_HOUR=20
GS_RATE_LIMIT_ASSISTANT_PER_MINUTE=10
GS_AUDIT_ENABLED=true

# --- CORS (Phase 09: must be exactly the production web origin(s)) ------------
# Comma-separated.  The browser talks to the same origin (/api behind Nginx)
# so CORS is effectively same-origin; keep this list tight anyway.
GS_CORS_ORIGINS=https://gsplatform.example.com

# --- Scene assistant (Phase 08, optional) ---
# GS_AI_API_KEY is a server-side secret; never expose to the browser.
# GS_AI_BASE_URL=https://apihub.agnes-ai.cn/v1
# GS_AI_MODEL=agnes-2.5-flash
# GS_AI_API_KEY=
# GS_AI_TIMEOUT_SECONDS=30

# --- Storage (Phase 06/09) ---
# Published data + uploads live under this root; Nginx exposes ONLY the
# scene-origin tree below (which contains published versions + current symlinks).
GS_STORAGE_ROOT=/srv/gsplatform-data
GS_SCENE_ORIGIN_ROOT=/srv/gsplatform-data/scene-origin
GS_UPLOAD_MAX_BYTES=5368709120
GS_UPLOAD_CHUNK_MAX_BYTES=67108864
GS_UPLOAD_EXPIRY_HOURS=24
GS_MAX_CONCURRENT_UPLOADS_PER_USER=5

# --- Workers (Celery, Phase 06/07) ---
CELERY_BROKER_URL=${GS_CELERY_BROKER_URL:-redis://127.0.0.1:6379/0}
CELERY_RESULT_BACKEND=${GS_CELERY_RESULT_BACKEND:-redis://127.0.0.1:6379/1}
# Number of task processes per worker (bounded by CPU).
CELERY_CPU_CONCURRENCY=4
# GPU worker: processes are 1 (training holds the device); task prefetch must
# stay small so queued training rows don't pile up on a busy GPU.
CELERY_GPU_CONCURRENCY=1

# --- Reconstruction toolchain (Phase 07) ---
# These must match the versions verified in Phase 07 on this host.
# FFMPEG_PATH=/usr/bin/ffmpeg
# COLMAP_PATH=/usr/local/bin/colmap
# GSPLAT_* and SPLAT_TRANSFORM_* paths if custom.