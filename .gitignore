# --- Node / pnpm ---
node_modules/
*.log
npm-debug.log*
pnpm-debug.log*
.pnpm-store/

# --- Build outputs ---
dist/
build/
coverage/
*.tsbuildinfo
.vite/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
