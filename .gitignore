.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# --- IDE / editor ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# --- System ---
Thumbs.db
Desktop.ini

# --- Env / secrets ---
.env
.env.*
!.env.example

# --- Logs ---
logs/
*.log

# --- Model / scene assets (large files never in git) ---
scenes/**/*.ply
scenes/**/*.sog
scenes/**/*.splat
scenes/**/*.mp4
scenes/**/*.jpg
scenes/**/*.jpeg
scenes/**/*.png
scenes/**/*.webp
scenes/**/*.avi
scenes/**/*.mov
scenes/**/*.mkv
scenes/**/*.zip
!scenes/.gitkeep

# --- Streamed SOG build output (built by build_streamed_sog.sh, never in git) ---
scenes/**/versions/
scenes/**/current
scenes/**/.staging-*

# --- Uploads / user data ---
uploads/
storage/
backups/
*.db
*.sqlite
*.sqlite3

# --- Misc ---
tmp/
temp/
*.tmp
test-results/
playwright-report/
